
# Configuration Gemini API
# IMPORTANT: Never commit your actual API key! Use .env.local for local development
VITE_GEMINI_API_KEY=PLACEHOLDER_YOUR_API_KEY_HERE_IN_ENV_LOCAL
VITE_GEMINI_MODEL=gemini-2.5-flash
VITE_GEMINI_TEMPERATURE=0.7
VITE_GEMINI_MAX_TOKENS=4096

# === NEW: UI Feature Flags ===
# Options: 'standard' | 'ministry' (controls UI theming)
VITE_UI_THEME=standard
VITE_ENABLE_MINISTRY=false
# Configuration Redis (Cache)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# Configuration MongoDB (Base de données)
MONGODB_URI=mongodb://localhost:27017/profiV
MONGODB_ENABLED=true

# Configuration Monitoring
MONITORING_ENABLED=true
LOG_LEVEL=info

# Configuration Supabase (Auth & Database)
SUPABASE_URL=https://postgres.fwzdtebmbamovyoofrru:9DPrHbVb94DR5VY6@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBvc3RncmVzcy5md3pkdGVibWJhbW92eW9vZnJy dTkiLCJhdWQiOiJzdXBhYmFhZG1pbiIsImlhdCI6MTY5ODc0MjE0NSwiZXhwIjoxOTUzMzA4MTQ1fQ.DlK3rX2Yt3bXoX1n0kY5Y6L1bF8K3l1Yz5vX9Z3rQ8k
SUPABASE_SERVICE_ROLE_KEY=votre_clé_service_role_supabase_ici

# Configuration Stripe (Paiements)
STRIPE_PUBLIC_KEY=votre_clé_publique_stripe_ici
STRIPE_SECRET_KEY=votre_clé_secrète_stripe_ici
STRIPE_WEBHOOK_SECRET=votre_secret_webhook_stripe_ici

# Configuration Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Configuration Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configuration Cache
CACHE_TTL=86400
CACHE_MAX_ENTRIES=1000
